# Build DAG for the smi report documents: figure scripts -> PDFs -> documents.
#
# Run from this directory:
#     pixi run -e report snakemake --cores all
# or, from anywhere in the repo, via the pixi tasks:
#     pixi run report / report-dry / report-clean / report-only
#
# Design notes
#
# - FIGURES is the single registry. Adding a figure means dropping
#   report/figures/plot_<name>.py on disk and adding <name> here.
#   tests/test_report_build.py checks those two stay in sync in both
#   directions, because a file-per-figure layout invites exactly that drift.
# - Documents depend on the figure PDFs they include, so editing one figure
#   script rebuilds that figure and the documents that use it, and nothing
#   else.
# - Everything generated lands in build/, which is gitignored.
# - Commands are kept to plain `python` / `typst` invocations with no shell
#   builtins, so the same rules run under cmd.exe, PowerShell and bash.

from pathlib import Path

REPORT_DIR = Path(workflow.basedir)
BUILD = "build"
FIGDIR = f"{BUILD}/figures"

# Which figures each document includes. Kept explicit rather than "all
# figures" so a document only rebuilds when something it actually shows
# changes.
DOCUMENT_FIGURES = {
    "report": [
        "baseline_summary",
        "baseline_amplitude_trend",
        "baseline_shot_traces",
        "freespace_vs_fiber",
        "model_comparison",
    ],
    "synthetic": [
        "exit_check",
        "sign_information",
        "feedback_curve",
        "noise_ladder",
        "fisher_phase",
        "velocity_bounds",
        "spectral_mismatch",
        "q1_binned",
        "leave_one_out",
        "q1_subsets",
        "model_families",
        "displacement_rmse",
    ],
}

# The figure registry: stem <name> maps to figures/plot_<name>.py ->
# build/figures/<name>.pdf. Derived rather than written out, because a figure
# that no document includes should not be built, and a figure a document
# includes must be. Maintaining both lists by hand made those two invariants
# something to remember and then test for; deriving makes them true by
# construction.
FIGURES = sorted({name for names in DOCUMENT_FIGURES.values() for name in names})

DOCUMENTS = sorted(DOCUMENT_FIGURES)

THEME = "lib/theme.typ"

# The results artifacts the figures read. Declared as figure inputs
# so regenerating them rebuilds the figures that quote them: without this the
# DAG only watches the scripts, and a regenerated artifact leaves stale figure
# PDFs beside a document whose tables have moved. Listed for all figures
# rather than per figure because the set is small and a figure that ignores
# them is only rebuilt spuriously, while one omitted from the list is wrong.
RESULTS_DIR = REPORT_DIR / "results"
RESULTS = [
    str(RESULTS_DIR / "baseline_results.json"),
    str(RESULTS_DIR / "gain_sweep_results.json"),
    str(RESULTS_DIR / "learned_results.json"),
    str(RESULTS_DIR / "synthetic_results.json"),
    # Per-sample binned errors of section Q1, from smi.experiments.q1_binned.
    str(RESULTS_DIR / "q1_binned_errors.json"),
]

# The library modules the figures compute from or read records through, so a
# change to the bounds, the forward model, a board constant, a preset or cell
# key (expand_grid, whose sim hashes the records are checked against), the
# frozen rig constants or the record loader rebuilds them. Listed for all
# figures for the same reason as RESULTS. Derived from the transitive smi
# imports of figures/*.py (grimp's find_upstream_modules over each module they
# import): that closure covers smi.core, .data, .estimators, .learning and
# .theory nearly whole -- smi.experiments.runner imports the training stack --
# so those are globbed whole (a module the figures never reach only costs a
# spurious rebuild), and only the three experiments modules it reaches are named.
SMI_DIR = REPORT_DIR.parent / "smi"
ANALYSIS_CODE = sorted(
    [
        *(
            str(p)
            for pkg in ("core", "data", "estimators", "learning", "theory")
            for p in (SMI_DIR / pkg).rglob("*.py")
        ),
        *(
            str(SMI_DIR / "experiments" / name)
            for name in ("evaluate.py", "results_artifact.py", "runner.py")
        ),
    ]
)

# The experiment grids the synthetic figures expand to label records (the
# sweep value of a cell comes from its grid). smi.experiments.grids imports
# every grid module, so any grid edit, or one to their types, rebuilds them.
GRIDS = sorted(
    [
        str(SMI_DIR / "experiments" / "grid.py"),
        *(str(p) for p in (SMI_DIR / "experiments" / "grids").glob("*.py")),
    ]
)

# The emitter instantiates the matched model configs to probe the input span of
# the sliding-window families (section Q2), so a model or config edit reruns it.
MODEL_DIR = SMI_DIR / "learning" / "models"
MODELS = sorted(
    str(p) for p in [*MODEL_DIR.glob("*.py"), SMI_DIR / "learning" / "configs.py"]
)

# Without this, the unconstrained {document} wildcard in `rule document` also
# matches "figures/<name>", so Snakemake evaluates a figure PDF as a candidate
# document output and its input function raises KeyError on every run. Pinning
# both wildcards to their registries keeps the DAG unambiguous.
wildcard_constraints:
    document="|".join(DOCUMENTS),
    name="|".join(FIGURES),


# Numbers a document quotes in its prose, computed by a script and read by the
# document at compile time, so the prose cannot drift from the library that
# produces the figures.
DOCUMENT_VALUES = {"synthetic": [f"{BUILD}/synthetic_values.json"]}


def figure_pdfs(document):
    return [f"{FIGDIR}/{name}.pdf" for name in DOCUMENT_FIGURES[document]]


rule all:
    input:
        expand(f"{BUILD}/{{document}}.pdf", document=DOCUMENTS),


rule figure:
    """Render one figure. The script writes exactly the path it is handed."""
    input:
        script="figures/plot_{name}.py",
        common="figures/_figcommon.py",
        results=RESULTS,
        code=ANALYSIS_CODE,
        grids=GRIDS,
    output:
        f"{FIGDIR}/{{name}}.pdf",
    shell:
        "python {input.script} --output {output}"


rule synthetic_values:
    """Compute the values synthetic.typ quotes in its text and table."""
    input:
        script="figures/synthetic_values.py",
        common="figures/_figcommon.py",
        results=RESULTS,
        code=ANALYSIS_CODE,
        grids=GRIDS,
        models=MODELS,
    output:
        f"{BUILD}/synthetic_values.json",
    shell:
        "python {input.script} --output {output}"


rule document:
    """Compile a Typst document against its figures."""
    input:
        source="{document}.typ",
        theme=THEME,
        bib="refs.bib",
        figures=lambda wildcards: figure_pdfs(wildcards.document),
        values=lambda wildcards: DOCUMENT_VALUES.get(wildcards.document, []),
    output:
        f"{BUILD}/{{document}}.pdf",
    shell:
        "typst compile --root . {input.source} {output}"


rule clean:
    """Remove every generated artifact."""
    run:
        import shutil

        shutil.rmtree(REPORT_DIR / BUILD, ignore_errors=True)
