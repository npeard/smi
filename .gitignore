# training data
# Matches every data/ directory, which is meant for raw acquisitions and
# frozen sets. smi/data/ (and smi/data/features/) is a Python package, so only its
# sources are re-included. The top-level data/ holds raw acquisitions and
# data/frozen/ the simulated frozen sets (regenerated on demand by
# smi.data.frozen.load_or_create, nothing tracked), so both stay ignored; only
# data/frozen/.gitkeep is tracked so that smi.core.paths.FROZEN_DIR exists in a
# fresh clone.
**/data/*
!/smi/data/*.py
!/smi/data/features/
!/smi/data/features/*.py
!/data/frozen/
/data/frozen/*
!/data/frozen/.gitkeep
**/checkpoints/*
**/lightning_logs/*

# The JSON files under report/results/ are version-controlled deliberately: each is a
# few KB of computed numbers that a report figure reads, while recomputing
# costs minutes to GPU-hours (baseline_results.json ~25 min, learned_results.json
# ~2.5 GPU-hours, gain_sweep_results.json ~25 min on CPU, synthetic_results.json
# the grid runs). Regenerate with `python -m smi.experiments.baselines`,
# `.gain_sweep`, `.run_baseline_sweep`, `.runner <grid name>` and `.q1_binned`
# (the last from gitignored checkpoints). Only the runner's lock is not a result.
report/results/.runner.lock

# Session-scoped agent scaffolding (specs, plans) -- durable rationale goes
# in commit messages and code comments instead.
docs/superpowers/
scratch/

# Generated report artifacts: figure PDFs and compiled documents. Snakemake's
# own state lives here too. Everything under it is reproducible from
# report/figures/*.py and the .typ sources via `pixi run report`.
report/build/
report/.snakemake/

# Grid checkpoints (runs/grids/<grid>/<cell-key>.ckpt) and training runs
# (runs/train/<run-name>/).
runs/
